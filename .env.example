# ═══════════════════════════════════════════════════════════
# LegalTek AI — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ── Public (exposed to the browser via env.js.php) ─────────
# Full URL to api.php as reachable from the browser.
API_URL=http://localhost/LegalTek/api.php

# Timezone the server writes timestamps in (PHP date() + MySQL
# CURRENT_TIMESTAMP). Keep this UTC: stored instants stay zone-neutral and
# the UI renders them in each viewer's local time. Changing it means
# migrating every existing datetime column to match.
APP_TIMEZONE=UTC

# ── Private (server-side only — NEVER exposed to the browser)
DB_HOST=localhost
DB_NAME=legaltek
DB_USER=root
DB_PASS=

# ── Ollama ─────────────────────────────────────────────────
# Use 127.0.0.1, NOT localhost: on Windows "localhost" resolves to ::1
# (IPv6) first, Ollama listens on IPv4 only, so every call wastes ~200ms
# failing over. Ollama must be running — `ollama serve` or the tray app.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=300
# Seconds between "is this answer still wanted?" checks while the model writes.
# Deleting a chat stops generation within roughly this window.
OLLAMA_CANCEL_POLL=1.0
