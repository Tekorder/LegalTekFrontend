# ═══════════════════════════════════════════════════════════
# LegalTek AI — deny direct HTTP access to dotfiles and secrets.
# Without this, http://localhost/LegalTek/.env serves DB_PASS as plain text.
# ═══════════════════════════════════════════════════════════

# All dotfiles: .env, .env.example, .git*, ...
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# env.php only defines helpers (config.php includes it from disk, not over HTTP),
# so there's no reason to allow a direct request for it.
<Files "env.php">
    Require all denied
</Files>

# ═══════════════════════════════════════════════════════════
# Never serve stale source. These files are transpiled in the browser at load
# time, and Apache sends no Cache-Control for them by default — so browsers
# fall back to heuristic caching and can keep running an old copy after an
# edit. A frontend one version behind the API produces confusing runtime
# errors instead of an obvious "reload me".
# ═══════════════════════════════════════════════════════════
<IfModule mod_headers.c>
    <FilesMatch "\.(jsx|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
