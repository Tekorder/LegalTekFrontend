# ═══════════════════════════════════════════════════════════
# LegalTek AI — Next.js frontend environment
# Copy to .env.local and fill in:   cp .env.local.example .env.local
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time —
# never put a secret in one. DB credentials, the Ollama host and the
# CourtListener token belong to the Express backend's own .env, not here.
# ═══════════════════════════════════════════════════════════

# ── Backend ────────────────────────────────────────────────
# Where the Express backend listens. Read at runtime by next.config.mjs, which
# proxies /api and /uploads to it — so it is server-side only and stays out of
# the bundle. Changing it needs a restart, not a rebuild.
BACKEND_URL=http://localhost:4000

# Base URL the browser calls. "/api" is same-origin and goes through the proxy
# above — no CORS. Set an absolute URL (https://api.legaltek.com/api) only when
# Express is deployed separately, and enable cors() on it if you do.
NEXT_PUBLIC_API_URL=/api

# Timezone the BACKEND writes timestamps in (its APP_TIMEZONE). The UI reads
# naive MySQL datetimes as wall clock in this zone, then renders them in each
# viewer's local time. Must match the backend or every timestamp shifts.
NEXT_PUBLIC_APP_TIMEZONE=UTC

# ── Firebase Auth (public by design — gated by security rules + authorized
#    domains, not by secrecy of these values) ───────────────
# Firebase Console → Project settings → Your apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
